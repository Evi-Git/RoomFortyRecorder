# The single guild served by this instance.
GUILD_CLOUD_GUILD=Room Forty

# Discord Developer Portal application values.
GUILD_CLOUD_DISCORD_CLIENT_ID=replace-with-discord-client-id
GUILD_CLOUD_DISCORD_CLIENT_SECRET=replace-with-discord-client-secret
GUILD_CLOUD_DISCORD_GUILD_ID=replace-with-room-forty-server-id
GUILD_CLOUD_DISCORD_BOT_TOKEN=replace-with-discord-bot-token
GUILD_CLOUD_DISCORD_ALLOWED_ROLES=raider,trial,officer
GUILD_CLOUD_DISCORD_REDIRECT_URI=https://roomfortyrecorder.com/auth/discord/callback

# Keep the Node server local; Caddy or a tunnel is the public HTTPS front door.
GUILD_CLOUD_HOST=127.0.0.1
GUILD_CLOUD_STORAGE_PATH=D:\GuildCloud
GUILD_CLOUD_LIMIT_GB=1800
GUILD_CLOUD_PORT=8787

# Public HTTPS URL served by Caddy or a tunnel. Do not add /api.
GUILD_CLOUD_PUBLIC_URL=https://roomfortyrecorder.com

# Random value used to sign video URLs and app sessions.
GUILD_CLOUD_SECRET=replace-with-a-long-random-value

# Live streaming (MediaMTX on this PC).
GUILD_CLOUD_LIVE_URL=https://live.example.com
# Optional: plain-OBS streaming (Bearer token raider:<password>).
GUILD_CLOUD_LIVE_RAIDER_PASSWORD=
# Optional: watching from a browser outside the house (viewer/<password>).
GUILD_CLOUD_LIVE_VIEWER_PASSWORD=
# Discord roles allowed to watch live streams in the app (comma-separated).
GUILD_CLOUD_LIVE_VIEWER_ROLES=Raider+,Officer
# MediaMTX's local API, used to list who is live.
# GUILD_CLOUD_MEDIAMTX_API=http://127.0.0.1:9997

# Pull desk: per-pull wipe reports from raiders' combat logs (pulldesk.mjs).
# Difficulties to report on: any of lfr, normal, heroic, mythic.
GUILD_CLOUD_PULLDESK_DIFFICULTIES=mythic
# Discord roles that may edit notes, avoidable spells and channels in the
# app. Defaults to GUILD_CLOUD_LIVE_VIEWER_ROLES.
# GUILD_CLOUD_PULLDESK_EDITOR_ROLES=Officer
# Discord channel for pull reports when a boss has none set in the app.
# The bot needs View Channel, Send Messages and Embed Links there.
GUILD_CLOUD_PULLDESK_DEFAULT_CHANNEL=
# Optional per-boss channels, encounterId:channelId pairs. The app's Boss
# settings tab is easier and overrides these.
# GUILD_CLOUD_PULLDESK_CHANNELS=3182:123456789012345678,3429:234567890123456789
# Days to keep uploaded log slices (reports are kept forever). 0 keeps all.
# GUILD_CLOUD_PULLDESK_LOG_DAYS=30
