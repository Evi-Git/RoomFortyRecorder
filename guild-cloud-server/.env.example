# The single guild served by this instance.
GUILD_CLOUD_GUILD=Room Forty

# Discord Developer Portal application values.
GUILD_CLOUD_DISCORD_CLIENT_ID=replace-with-discord-client-id
GUILD_CLOUD_DISCORD_CLIENT_SECRET=replace-with-discord-client-secret
GUILD_CLOUD_DISCORD_GUILD_ID=replace-with-room-forty-server-id
GUILD_CLOUD_DISCORD_BOT_TOKEN=replace-with-discord-bot-token
GUILD_CLOUD_DISCORD_ALLOWED_ROLES=raider,trial,officer
GUILD_CLOUD_DISCORD_REDIRECT_URI=https://cloud.example.com/auth/discord/callback

# Keep the Node server local; Caddy or a tunnel is the public HTTPS front door.
GUILD_CLOUD_HOST=127.0.0.1
GUILD_CLOUD_STORAGE_PATH=D:\GuildCloud
GUILD_CLOUD_LIMIT_GB=1800
GUILD_CLOUD_PORT=8787

# Public HTTPS URL served by Caddy or a tunnel. Do not add /api.
GUILD_CLOUD_PUBLIC_URL=https://cloud.example.com

# Random value used to sign video URLs and app sessions.
GUILD_CLOUD_SECRET=replace-with-a-long-random-value
